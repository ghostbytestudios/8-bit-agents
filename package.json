{
  "name": "harness",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @harness/client",
    "server": "npm run dev -w @harness/server",
    "build": "npm run build -w @harness/client",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "^5.0.5"
  }
}
